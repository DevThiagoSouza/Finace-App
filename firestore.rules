rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada "casa" é um documento isolado: households/{CODIGO}
    // O código da casa funciona como a "chave" de acesso (igual ao app web).
    // Não é permitido LISTAR casas: só quem sabe o código consegue abrir (get).
    match /households/{houseId} {
      allow get:    if request.auth != null;
      allow list:   if false;
      allow create: if request.auth != null
                    && request.resource.data.name is string
                    && request.resource.data.members is list
                    && request.resource.data.members.size() >= 1;
      allow update: if request.auth != null
                    && request.resource.data.members is list
                    && request.resource.data.members.size() >= 1;
      allow delete: if false;

      // Despesas fixas, lançamentos variáveis etc.
      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
